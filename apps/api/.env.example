# Runtime environment: development, test, or production
NODE_ENV=development
# Address and port used by the HTTP server
HOST=127.0.0.1
PORT=3001
# Frontend origin permitted by CORS
CORS_ORIGIN=http://localhost:5173
# Fastify/Pino log level
LOG_LEVEL=info
# PostgreSQL connection string
DATABASE_URL=postgresql://career:career_password@127.0.0.1:5432/career_ai
# Database connection pool size
DATABASE_POOL_SIZE=10
