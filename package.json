{
  "name": "career-intelligence-assistant",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22.0.0 <23.0.0"
  },
  "scripts": {
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @career/api db:migrate",
    "db:reset": "docker compose down -v"
  }
}

